VITE_API_URL=http://localhost:3050
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opcional. "true" mostra na Home trabalhos de DEMONSTRAÇÃO (inventados) quando a API ainda não tem
# nenhum, para avaliar o aspecto com a montra cheia; a Home avisa que são dados de demonstração.
# Se faltar (ou não for "true"), a montra mostra só trabalhos reais — e, sem nenhum, "Ainda não há
# trabalhos publicados". Não ligar em produção aberta ao público. Como todas as VITE_*, é lida no
# build: alterá-la exige novo deploy.
VITE_MONTRA_DE_DEMONSTRACAO=
